# Build, verify, and publish the staged module.
# Run with: box run-script release
# Start the test server on port 60310 before running this recipe.
# See docs/release-process.md for the packaging safeguards.

# Update local main from the remote repository.
!git checkout -f main
!git pull origin main

# Run all tests and build the staged module and zip.
run-script build:module

# Publish the verified files from the staging directory.
cd .tmp/erroralerts
publish
cd ../../

# Tag the published version manually:
#   git tag v<version> && git push origin main --tags
