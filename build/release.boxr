# The one-command release: build (test-gated), publish to ForgeBox, tag, GitHub Release.
# Run with: box run-script publish:release
# NOTE recipe comment syntax: a line must start with "#" PLUS A SPACE and some text.
# A bare "#" on its own line is NOT a comment - CommandBox tries to run it as a command
# and the recipe dies with: Command "#" cannot be resolved.

# Requires: a test server running on port 60310 (box run-script start:2023 or start:boxlang),
# a changelog.md section for the version in box.json (preflight refuses without one; that
# section becomes the GitHub Release notes), and the gh CLI logged in (gh auth login).
# Before releasing, run the full cross-engine sweep: box run-script test:release

# ALWAYS release with `box run-script publish:release`. Never run a bare `box publish`
# from the repo root: CommandBox reads .gitignore when it packages, so any
# unanchored ignore pattern silently strips matching source folders from the
# published module. That is how caffeinecms 1.0.0-beta.1 shipped with missing
# models and every app that installed it died at startup. buildSource() now counts
# the zip contents and aborts on a mismatch, so this path is the guarded one.

# Refuse to start unless: clean tree, on main, version untagged, changelog entry
# exists, gh is logged in. This MUST come before the forced checkout below, which
# silently discards uncommitted changes.
task run taskFile=build/Release.cfc target=preflight :version=`package show version`

# Fail fast if local main is not what the remote has.
!git checkout -f main
!git pull origin main

# Build: runs the FULL test suite first and aborts on any failure, then writes
# the slim module tree to .tmp/erroralerts/ and the distributable zip to
# .artifacts/erroralerts/<version>/.
run-script build:module

# Publish from the built tree, not the repo root, so ForgeBox receives exactly
# what the build produced (no reliance on box.json's ignore list).
cd .tmp/erroralerts
publish
cd ../../

# The GitHub half: create tag v<version>, push it, and create a GitHub Release
# with notes from changelog.md plus the built zip and its sha512 attached.
task run taskFile=build/Release.cfc target=github :version=`package show version`
