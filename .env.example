# Test harness settings. Copy this file to .env and restart the server.
# .env is gitignored. CommandBox reads it through commandbox-dotenv.

# Which cbmailservices mailer is active when the server starts.
#   unset or default = keep sent mail in memory (what the TestBox specs read)
#   smtp             = send real email to a local mail catcher
#   mailtrap         = send real email to a Mailtrap sandbox inbox
# Any value but default also shortens the throttle window so digest emails
# arrive about a minute after a burst instead of ten.
#
# Leave this commented out. The integration specs read the in-memory mailbox, so
# with a sending mailer active the mailbox stays empty and those specs fail.
# To read alerts as real email, switch mailers at runtime instead: use the links
# on the harness home page, or request /main/mailer?use=mailtrap. That needs no
# restart, and /main/mailer?use=default switches back before you run the specs.
# ERRORALERTS_MAILER=smtp

# Where the smtp mailer sends. Point these at your local mail catcher.
ERRORALERTS_SMTP_SERVER=127.0.0.1
ERRORALERTS_SMTP_PORT=25

# A Mailtrap sandbox inbox, which is readable on a phone at mailtrap.io.
# Copy the credentials from your inbox's SMTP settings into .env, which is
# gitignored. Never put real credentials in this file.
ERRORALERTS_MAILTRAP_SERVER=sandbox.smtp.mailtrap.io
ERRORALERTS_MAILTRAP_PORT=2525
ERRORALERTS_MAILTRAP_USERNAME=your-mailtrap-inbox-username
ERRORALERTS_MAILTRAP_PASSWORD=your-mailtrap-inbox-password
# Mailtrap makes STARTTLS optional on every port. Set this to false if the
# engine's truststore refuses the handshake.
ERRORALERTS_MAILTRAP_TLS=true

# Addresses on the alert emails.
ERRORALERTS_TO=alerts@example.com
ERRORALERTS_FROM=harness@example.com
