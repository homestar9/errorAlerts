# Test harness settings. Copy this file to .env and restart the server.
# .env is gitignored. CommandBox reads it through commandbox-dotenv.

# Which cbmailservices mailer the harness uses.
#   unset or default = keep sent mail in memory (what the TestBox specs read)
#   smtp             = send real email through the cfmail tag
# Setting this to smtp also shortens the throttle window so digest emails
# arrive about a minute after a burst instead of ten.
#
# Leave this commented out to run the test suite. The integration specs read the
# in-memory mailbox, so with the smtp mailer active the mailbox stays empty and
# those specs fail. Uncomment it only when you want to read the alerts as real
# email in a local mail catcher, then comment it out again and restart the
# server before running the specs.
# ERRORALERTS_MAILER=smtp

# Where the smtp mailer sends. Point these at your local mail catcher.
ERRORALERTS_SMTP_SERVER=127.0.0.1
ERRORALERTS_SMTP_PORT=25

# Addresses on the alert emails.
ERRORALERTS_TO=alerts@example.com
ERRORALERTS_FROM=harness@example.com
