# Anchor directory patterns with a leading "/". Packaging uses the box.json
# ignore list, not this file. See docs/release-process.md.

# General Ignores + IDE
.DS_Store
settings.xml
WEB-INF
/.vscode/
\.idea/
Thumbs.db
.engine/**
/.engine/
/.artifacts/
/.tmp/
/modules/

# Test Harness
/test-results/
/test-harness/coldbox/
/test-harness/testbox/
/test-harness/modules/
/test-harness/logs/

# These patterns match file names rather than directories.
.env
*.bak

# Developer notes
plans/**

# commandbox-release build output
.tmp/
.artifacts/
