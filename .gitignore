# when packaging the repository. See docs/release-process.md.
/.engine/
/.artifacts/
/.tmp/
/modules/
/test-results/
/test-harness/coldbox/
/test-harness/testbox/
/test-harness/modules/
/test-harness/logs/

# These patterns match file names rather than directories.
.env
*.bak
